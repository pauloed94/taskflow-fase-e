# Modelo das variaveis da stack de observabilidade. Este arquivo pode ser versionado: so tem NOMES.
# Como usar: cp .env.example .env   (o .env NUNCA vai para o Git; confira o .gitignore)

# Senha do usuario "admin" do Grafana. Use um valor proprio, mesmo em ambiente de estudo.
GRAFANA_ADMIN_PASSWORD=troque-a-senha-do-grafana
