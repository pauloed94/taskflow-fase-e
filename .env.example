# Modelo das variaveis do docker-compose.yml. Este arquivo pode ser versionado: so tem NOMES.
# Como usar: cp .env.example .env   (o .env NUNCA vai para o Git; confira o .gitignore)
# Preencha o .env com valores proprios, mesmo em ambiente de estudo.

# Banco de dados PostgreSQL (servico "db").
POSTGRES_USER=troque-o-usuario
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=taskflow

# Chave de sessao do Flask (gere uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Senhas dos usuarios de demonstracao "admin" e "aluno" (o app as exige ao iniciar).
TASKFLOW_ADMIN_PASSWORD=troque-a-senha-do-admin
TASKFLOW_USER_PASSWORD=troque-a-senha-do-aluno
